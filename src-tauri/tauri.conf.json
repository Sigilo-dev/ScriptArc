{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScriptArc",
  "mainBinaryName": "ScriptArc",
  "version": "0.1.0",
  "identifier": "com.sigilo.scriptarc",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ScriptArc",
        "width": 1180,
        "height": 820,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1421",
        "img-src": "'self' asset: http://asset.localhost data:",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "copyright": "Copyright 2026 ScriptArc contributors",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "publisher": "ScriptArc contributors",
    "shortDescription": "Free and open-source desktop teleprompter",
    "longDescription": "A lightweight desktop teleprompter with word-level automatic pacing, manual timing recording, Markdown scripts and configurable themes.",
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "ScriptArc"
      }
    }
  }
}
